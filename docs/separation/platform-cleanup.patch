-
-/** Aparición suave al entrar en pantalla. Visible por defecto en SSR y con movimiento reducido. */
-export function Reveal({
-  children,
-  className,
-  as: Tag = "div",
-  delay = 0,
-}: {
-  children: ReactNode;
-  className?: string;
-  as?: "div" | "section" | "li" | "article";
-  delay?: number;
