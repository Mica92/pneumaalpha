-      (entries) => {
-        for (const entry of entries) {
-          if (entry.isIntersecting) {
-            window.setTimeout(() => {
-              el.dataset.visible = "true";
-            }, delay);
-            io.disconnect();
-          }
-        }
-      },
-      { rootMargin: "0px 0px -8% 0px" },
-    );
-    io.observe(el);
-    return () => io.disconnect();
-  }, [delay]);
